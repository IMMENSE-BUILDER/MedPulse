# Copy to .env.local and fill in.

# TinyFish AI — free-tier Search/Fetch + paid live browser Agent
TINYFISH_API_KEY=

# Vercel AI Gateway — enables the dual-model pipeline
# (vision model for prescription OCR, clinical text model for everything else;
#  model IDs are app defaults, optionally overridable via env — never shown in the UI)
AI_GATEWAY_API_KEY=

# auto = live when keys are present, else labelled demo | demo = always demo | live = require keys
MEDPULSE_MODE=auto

# Optional overrides
DEFAULT_PINCODE=110053
CACHE_TTL_SECONDS=3600
# VISION_MODEL=
# TEXT_MODEL=
